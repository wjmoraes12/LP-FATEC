<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        prefHeight="760.0"
        prefWidth="640.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.javafx.MenuController">

    <top>
        <VBox alignment="CENTER" spacing="6" style="-fx-padding: 20 20 10 20;">

            <Label text="MENU PRINCIPAL" textAlignment="CENTER">
                <font>
                    <Font name="System Bold" size="36.0"/>
                </font>
            </Label>

            <Label text="Qual você deseja rodar?" textAlignment="CENTER">
                <font>
                    <Font size="20.0"/>
                </font>
            </Label>

            <MenuButton
                    fx:id="menuProgramas"
                    mnemonicParsing="false"
                    prefHeight="50.0"
                    prefWidth="400.0"
                    text="Escolha o programa">

                <items>

                    <MenuItem mnemonicParsing="false" text="Verificação de Múltiplo"
                              onAction="#onMultiplo"/>
                    <MenuItem mnemonicParsing="false" text="Sistema de Login Simplificado"
                              onAction="#onLogin"/>
                    <MenuItem mnemonicParsing="false" text="Compra com Desconto"
                              onAction="#onDesconto"/>
                    <MenuItem mnemonicParsing="false" text="Temperatura"
                              onAction="#onTemperatura"/>
                    <MenuItem mnemonicParsing="false" text="Os 35 Camelos"
                              onAction="#onCamelo"/>
                    <MenuItem mnemonicParsing="false" text="Calculadora de Viagem"
                              onAction="#onViagem"/>
                    <MenuItem mnemonicParsing="false" text="Aluguel de Carro"
                              onAction="#onAluguel"/>

                    <SeparatorMenuItem/>

                    <MenuItem mnemonicParsing="false" text="Loja de Roupas"
                              onAction="#onLoja"/>
                    <MenuItem mnemonicParsing="false" text="Ciclismo na Trilha"
                              onAction="#onCiclismo"/>
                    <MenuItem mnemonicParsing="false" text="Exposição de Máscaras"
                              onAction="#onMascaras"/>
                    <MenuItem mnemonicParsing="false" text="Salão de Cabeleireiro"
                              onAction="#onSalao"/>

                    <SeparatorMenuItem/>

                    <MenuItem mnemonicParsing="false" text="Sair"
                              onAction="#onSair"/>

                </items>

                <font>
                    <Font size="20.0"/>
                </font>

            </MenuButton>

            <Separator/>

        </VBox>
    </top>

    <center>
        <ScrollPane fx:id="scrollConteudo" fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: transparent;">

            <StackPane fx:id="areaConteudo" alignment="TOP_CENTER" style="-fx-padding: 10;">
                <Label text="Escolha um programa no menu acima."
                       style="-fx-font-size: 18px; -fx-padding: 40 0 0 0;"/>
            </StackPane>

        </ScrollPane>
    </center>

</BorderPane>
