<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="702.0"
        prefWidth="600.0"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="org.example.javafx.MenuController">

    <children>

        <Label
                layoutX="129.0"
                layoutY="30.0"
                text="MENU PRINCIPAL"
                textAlignment="CENTER">

            <font>
                <Font name="System Bold" size="44.0"/>
            </font>

        </Label>

        <Label
                layoutX="148.0"
                layoutY="92.0"
                text="Qual você deseja rodar?"
                textAlignment="CENTER">

            <font>
                <Font size="30.0"/>
            </font>

        </Label>

        <MenuButton
                layoutX="132.0"
                layoutY="178.0"
                mnemonicParsing="false"
                prefHeight="90.0"
                prefWidth="341.0"
                text="Escolha o programa">

            <items>

                <MenuItem
                        mnemonicParsing="false"
                        text="Verificação de Múltiplo"
                        onAction="#onMultiplo"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Sistema de Login Simplificado"
                        onAction="#onLogin"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Compra com Desconto"
                        onAction="#onDesconto"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Temperatura"
                        onAction="#onTemperatura"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Os 35 Camelos"
                        onAction="#onCamelo"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Calculadora de Viagem"
                        onAction="#onViagem"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Aluguel de Carro"
                        onAction="#onAluguel"/>

                <MenuItem
                        mnemonicParsing="false"
                        text="Sair"
                        onAction="#onSair"/>

            </items>

            <font>
                <Font size="25.0"/>
            </font>

        </MenuButton>

    </children>

</AnchorPane>