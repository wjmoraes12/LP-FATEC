<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="540" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx.SalaoController">

    <Label text="Salão de Cabeleireiro" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Preencha os dados de cada aba e clique em Criar para liberar as ações."
           wrapText="true"/>

    <TabPane tabClosingPolicy="UNAVAILABLE">
        <Tab text="Cliente">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtClienteNome" promptText="Nome"/>
                <TextField fx:id="txtClienteTelefone" promptText="Telefone"/>
                <TextField fx:id="txtClienteTipoCabelo" promptText="Tipo de cabelo (ex.: cacheado)"/>
                <Button text="Criar Cliente" onAction="#onCriarCliente"/>
                <HBox fx:id="boxCliente" spacing="8" disable="true">
                    <Button text="Agendar corte" onAction="#onClienteAgendarCorte"/>
                    <Button text="Escolher estilo" onAction="#onClienteEscolherEstilo"/>
                    <Button text="Atualizar telefone" onAction="#onClienteAtualizarTelefone"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Corte">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtCorteEstilo" promptText="Estilo"/>
                <TextField fx:id="txtCorteComprimento" promptText="Comprimento (ex.: curto)"/>
                <TextField fx:id="txtCortePreco" promptText="Preço (R$)"/>
                <Button text="Criar Corte" onAction="#onCriarCorte"/>
                <VBox fx:id="boxCorte" spacing="8" disable="true">
                    <HBox spacing="8">
                        <Button text="Realizar corte" onAction="#onCorteRealizar"/>
                        <Button text="Exibir preço" onAction="#onCorteExibirPreco"/>
                    </HBox>
                    <HBox spacing="8">
                        <TextField fx:id="txtCorteNovoEstilo" promptText="Novo estilo"/>
                        <Button text="Alterar estilo" onAction="#onCorteAlterarEstilo"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>
        <Tab text="Cabeleireiro">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtCabeleireiroNome" promptText="Nome"/>
                <TextField fx:id="txtCabeleireiroEspecialidade" promptText="Especialidade"/>
                <TextField fx:id="txtCabeleireiroAnos" promptText="Anos de experiência"/>
                <Button text="Criar Cabeleireiro" onAction="#onCriarCabeleireiro"/>
                <HBox fx:id="boxCabeleireiro" spacing="8" disable="true">
                    <Button text="Atender cliente" onAction="#onCabeleireiroAtender"/>
                    <Button text="Demonstrar especialidade" onAction="#onCabeleireiroDemonstrar"/>
                    <Button text="Informar experiência" onAction="#onCabeleireiroInformarExperiencia"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <Label text="Resultado:"/>
    <TextArea fx:id="txtLog" editable="false" wrapText="true" prefRowCount="8"/>
    <Button text="Limpar" onAction="#onLimpar"/>
</VBox>
