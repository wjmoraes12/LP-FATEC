<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="540" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx.MascarasController">

    <Label text="Exposição de Máscaras" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Preencha os dados de cada aba e clique em Criar para liberar as ações."
           wrapText="true"/>

    <TabPane tabClosingPolicy="UNAVAILABLE">
        <Tab text="Máscara">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtMascaraOrigem" promptText="Origem"/>
                <TextField fx:id="txtMascaraMaterial" promptText="Material"/>
                <TextField fx:id="txtMascaraEstilo" promptText="Estilo"/>
                <Button text="Criar Máscara" onAction="#onCriarMascara"/>
                <HBox fx:id="boxMascara" spacing="8" disable="true">
                    <Button text="Exibir detalhes" onAction="#onMascaraExibirDetalhes"/>
                    <Button text="Restaurar" onAction="#onMascaraRestaurar"/>
                    <Button text="Catalogar" onAction="#onMascaraCatalogar"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Colecionador">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtColecionadorNome" promptText="Nome"/>
                <TextField fx:id="txtColecionadorPecas" promptText="Quantidade de peças"/>
                <TextField fx:id="txtColecionadorEspecialidade" promptText="Especialidade"/>
                <Button text="Criar Colecionador" onAction="#onCriarColecionador"/>
                <HBox fx:id="boxColecionador" spacing="8" disable="true">
                    <Button text="Adicionar máscara" onAction="#onColecionadorAdicionarMascara"/>
                    <Button text="Pesquisar origem" onAction="#onColecionadorPesquisarOrigem"/>
                    <Button text="Apresentar coleção" onAction="#onColecionadorApresentarColecao"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Exposição">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtExposicaoNome" promptText="Nome da exposição"/>
                <TextField fx:id="txtExposicaoLocal" promptText="Local"/>
                <TextField fx:id="txtExposicaoQuantidade" promptText="Quantidade de máscaras"/>
                <Button text="Criar Exposição" onAction="#onCriarExposicao"/>
                <HBox fx:id="boxExposicao" spacing="8" disable="true">
                    <Button text="Abrir" onAction="#onExposicaoAbrir"/>
                    <Button text="Informar acervo" onAction="#onExposicaoInformarAcervo"/>
                    <Button text="Encerrar" onAction="#onExposicaoEncerrar"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <Label text="Resultado:"/>
    <TextArea fx:id="txtLog" editable="false" wrapText="true" prefRowCount="8"/>
    <Button text="Limpar" onAction="#onLimpar"/>
</VBox>
