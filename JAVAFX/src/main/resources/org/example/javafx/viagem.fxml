<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" prefWidth="420" style="-fx-padding: 25;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx.ViagemController">

    <Label text="Calculadora de Viagem" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <TextField fx:id="txtDistancia" promptText="Distância da viagem (km)"/>
    <TextField fx:id="txtValor" promptText="Valor pago no combustível (R$ por litro)"/>
    <Button text="Calcular" onAction="#onCalcular" defaultButton="true"/>
    <Label fx:id="lblResultado" wrapText="true" textAlignment="CENTER"
           style="-fx-font-size: 18px;"/>
</VBox>
