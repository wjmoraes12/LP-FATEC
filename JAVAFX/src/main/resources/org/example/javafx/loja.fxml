<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefWidth="540" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx.LojaController">

    <Label text="Loja de Roupas" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label text="Preencha os dados de cada aba e clique em Criar para liberar as ações."
           wrapText="true"/>

    <TabPane tabClosingPolicy="UNAVAILABLE">
        <Tab text="Roupa">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtRoupaTipo" promptText="Tipo (ex.: camisa)"/>
                <TextField fx:id="txtRoupaCor" promptText="Cor"/>
                <TextField fx:id="txtRoupaPreco" promptText="Preço (R$)"/>
                <Button text="Criar Roupa" onAction="#onCriarRoupa"/>
                <HBox fx:id="boxRoupa" spacing="8" disable="true">
                    <Button text="Vestir" onAction="#onRoupaVestir"/>
                    <Button text="Vender" onAction="#onRoupaVender"/>
                    <Button text="Exibir preço" onAction="#onRoupaExibirPreco"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Manequim">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtManequimMaterial" promptText="Material"/>
                <TextField fx:id="txtManequimCor" promptText="Cor"/>
                <TextField fx:id="txtManequimRoupa" promptText="Roupa que está vestindo"/>
                <Button text="Criar Manequim" onAction="#onCriarManequim"/>
                <HBox fx:id="boxManequim" spacing="8" disable="true">
                    <Button text="Vestir roupa" onAction="#onManequimVestirRoupa"/>
                    <Button text="Exibir" onAction="#onManequimExibir"/>
                    <Button text="Trocar roupa" onAction="#onManequimTrocarRoupa"/>
                </HBox>
            </VBox>
        </Tab>
        <Tab text="Loja">
            <VBox spacing="8" style="-fx-padding: 15;">
                <TextField fx:id="txtLojaNome" promptText="Nome da loja"/>
                <TextField fx:id="txtLojaEndereco" promptText="Endereço"/>
                <TextField fx:id="txtLojaFuncionarios" promptText="Quantidade de funcionários"/>
                <Button text="Criar Loja" onAction="#onCriarLoja"/>
                <HBox fx:id="boxLoja" spacing="8" disable="true">
                    <Button text="Abrir" onAction="#onLojaAbrir"/>
                    <Button text="Fechar" onAction="#onLojaFechar"/>
                    <Button text="Exibir informações" onAction="#onLojaExibirInformacoes"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <Label text="Resultado:"/>
    <TextArea fx:id="txtLog" editable="false" wrapText="true" prefRowCount="8"/>
    <Button text="Limpar" onAction="#onLimpar"/>
</VBox>
