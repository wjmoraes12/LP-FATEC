<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12" prefWidth="420" style="-fx-padding: 25;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.javafx.LoginController">

    <Label text="Sistema de Login Simplificado" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <TextField fx:id="txtUsuario" promptText="Usuário"/>
    <PasswordField fx:id="txtSenha" promptText="Senha"/>
    <Button text="Entrar" onAction="#onCalcular" defaultButton="true"/>
    <Label fx:id="lblResultado" wrapText="true" textAlignment="CENTER"/>
</VBox>
